<header class="sticky top-0 z-50 bg-white">
  <div class="bg-stem text-white text-xs lg:text-[13px] text-center py-2 px-4 tracking-wide">
    台北市區當日配送<span class="mx-2 lg:mx-4 opacity-50">|</span><span class="lg:hidden">滿</span><span class="hidden lg:inline">消費滿</span> NT$ 500 免運
  </div>
  <div class="border-b border-line">
    <div class="mx-auto max-w-[1200px] px-5 lg:px-8 h-[60px] lg:h-[76px] flex items-center justify-between gap-6">
      <details class="lg:hidden relative" id="mobile-nav">
        <summary class="list-none cursor-pointer p-2 -ml-2 text-ink" aria-label="開啟選單">
          <%- include('icon', { name: 'menu', cls: 'w-6 h-6' }) %>
        </summary>
        <nav class="absolute left-0 top-full mt-3 w-60 bg-white border border-line rounded-md shadow-lg p-2 flex flex-col text-[15px] text-ink">
          <a href="/#products" class="px-3 py-2.5 rounded hover:bg-tissue">所有花禮</a>
          <a href="/orders" class="px-3 py-2.5 rounded hover:bg-tissue">我的訂單</a>
          <a href="/cart" class="px-3 py-2.5 rounded hover:bg-tissue">購物車</a>
          <div id="auth-nav-mobile" class="border-t border-line mt-1 pt-1 flex flex-col"></div>
        </nav>
      </details>

      <a href="/" class="flex items-end gap-2.5">
        <span class="font-serif font-bold text-xl lg:text-2xl text-stem">花漾生活</span>
        <span class="hidden lg:inline font-num italic text-sm text-ink-3 pb-0.5">Flower Life</span>
      </a>

      <% const ordersActive = typeof pageScript !== 'undefined' && pageScript === 'orders'; %>
      <nav class="hidden lg:flex items-center gap-10 text-[15px]">
        <a href="/#products" class="<%= ordersActive ? 'text-ink-2' : 'text-ink' %> hover:text-rose transition-colors">所有花禮</a>
        <a href="/orders" class="<%= ordersActive ? 'text-ink font-medium' : 'text-ink-2' %> hover:text-rose transition-colors" <%- ordersActive ? 'aria-current="page"' : '' %>>我的訂單</a>
      </nav>

      <div class="flex items-center gap-7">
        <div id="auth-nav" class="hidden lg:flex items-center gap-2.5 text-[15px] text-ink"></div>
        <a href="/cart" class="relative flex items-center gap-2 text-[15px] text-ink hover:text-rose transition-colors p-2 -mr-2 lg:p-0 lg:mr-0" aria-label="購物車">
          <%- include('icon', { name: 'shopping-bag', cls: 'w-6 h-6 lg:w-5 lg:h-5' }) %>
          <span class="hidden lg:inline">購物車</span>
          <span
            id="cart-badge"
            class="absolute top-0 right-0 lg:static bg-rose text-white text-[11px] lg:text-xs font-medium rounded-full min-w-[18px] h-[18px] lg:min-w-[22px] lg:h-[22px] px-1 items-center justify-center"
            style="display: none;"
          ></span>
        </a>
      </div>
    </div>
  </div>
</header>

<div id="app" class="container-page pb-10 pt-7 lg:pb-28 lg:pt-12">
  <div class="flex items-end justify-between">
    <h1 class="font-serif text-[30px] font-semibold text-stem lg:text-[40px]">購物車</h1>
    <p v-if="items.length" class="text-sm text-ink-2 lg:text-[15px]">共 {{ items.length }} 項<span class="hidden lg:inline">商品</span></p>
  </div>

  <div v-if="loading" class="flex justify-center py-24"><div class="spinner"></div></div>

  <div v-else-if="items.length === 0" class="py-20 text-center">
    <p class="font-serif text-xl text-stem">購物車是空的</p>
    <p class="mt-2 text-sm text-ink-2">挑一束花，送給想念的人吧。</p>
    <a href="/#products" class="btn-primary mt-6">瀏覽所有花禮</a>
  </div>

  <template v-else>
    <div class="mt-5 flex flex-col gap-5 lg:mt-8 lg:flex-row lg:items-start lg:gap-14">
      <div class="lg:flex-1">
        <div class="flex flex-col gap-2.5 rounded-md px-4 py-3.5 lg:hidden" :class="freeShipping ? 'bg-sage-bg' : 'bg-tissue'">
          <p class="flex items-center gap-2 text-sm font-medium" :class="freeShipping ? 'text-sage-ink' : 'text-rose'">
            <%- include('../partials/icon', { name: 'circle-check', cls: 'w-4 h-4' }) %>
            {{ freeShipping ? '已達免運門檻' : '再買 NT$ ' + (FREE_SHIPPING_THRESHOLD - total).toLocaleString() + ' 即可免運' }}
          </p>
        </div>

        <div class="mt-5 border-t border-line lg:mt-0">
          <div class="hidden gap-6 border-b border-line py-3.5 text-[13px] text-ink-3 lg:flex">
            <span class="flex-1">商品</span><span class="w-[136px]">數量</span><span class="w-[120px] text-right">小計</span><span class="w-5"></span>
          </div>
          <div v-for="item in items" :key="item.id" class="flex gap-3.5 border-b border-line py-[18px] lg:items-center lg:gap-6 lg:py-6">
            <a :href="'/products/' + item.product.id" class="shrink-0">
              <img :src="sizedImage(item.product.image_url, 200)" :alt="item.product.name" class="h-[104px] w-[84px] rounded object-cover lg:h-[120px] lg:w-24" />
            </a>
            <div class="flex flex-1 flex-col gap-2.5 lg:flex-row lg:items-center lg:gap-6">
              <div class="flex justify-between lg:flex-1 lg:flex-col lg:justify-start lg:gap-1.5">
                <div class="flex flex-col gap-1 lg:gap-1.5">
                  <a :href="'/products/' + item.product.id" class="text-[15px] font-medium lg:text-base">{{ item.product.name }}</a>
                  <p class="font-num text-sm text-ink-2 lg:text-[15px]">NT$ {{ item.product.price.toLocaleString() }}</p>
                </div>
                <button @click="confirmDelete(item.id)" class="self-start text-ink-3 transition-colors hover:text-error lg:hidden" aria-label="移除商品"><%- include('../partials/icon', { name: 'trash-2' }) %></button>
              </div>
              <div class="flex items-center justify-between lg:contents">
                <div class="qty h-[38px] lg:h-11 lg:w-[136px]">
                  <button @click="updateQuantity(item.id, item.quantity - 1)" :disabled="item.quantity <= 1" class="w-[38px] lg:w-11" aria-label="減少數量"><%- include('../partials/icon', { name: 'minus', cls: 'w-4 h-4' }) %></button>
                  <span class="w-10 lg:w-12">{{ item.quantity }}</span>
                  <button @click="updateQuantity(item.id, item.quantity + 1)" :disabled="item.quantity >= item.product.stock" class="w-[38px] lg:w-11" aria-label="增加數量"><%- include('../partials/icon', { name: 'plus', cls: 'w-4 h-4' }) %></button>
                </div>
                <p class="font-num text-base lg:w-[120px] lg:text-right lg:text-[17px]">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</p>
              </div>
              <button @click="confirmDelete(item.id)" class="hidden text-ink-3 transition-colors hover:text-error lg:block" aria-label="移除商品"><%- include('../partials/icon', { name: 'trash-2' }) %></button>
            </div>
          </div>
          <a href="/#products" class="hidden items-center gap-2 py-5 text-[15px] text-rose hover:text-rose-deep lg:inline-flex"><%- include('../partials/icon', { name: 'arrow-left', cls: 'w-4 h-4' }) %>繼續選購</a>
        </div>
      </div>

      <aside class="flex flex-col gap-3.5 rounded-md bg-tissue p-5 lg:w-[400px] lg:gap-[18px] lg:p-8">
        <h2 class="font-serif text-lg font-semibold text-stem lg:text-[22px]">訂單摘要</h2>
        <div class="hidden flex-col gap-2.5 rounded-md bg-white p-4 lg:flex">
          <p class="flex items-center gap-2 text-sm font-medium" :class="freeShipping ? 'text-sage-ink' : 'text-rose'">
            <%- include('../partials/icon', { name: 'circle-check', cls: 'w-4 h-4' }) %>
            {{ freeShipping ? '已達免運門檻' : '再買 NT$ ' + (FREE_SHIPPING_THRESHOLD - total).toLocaleString() + ' 即可免運' }}
          </p>
          <div class="h-1.5 overflow-hidden rounded-full bg-line">
            <div class="h-full rounded-full transition-all" :class="freeShipping ? 'bg-sage-ink' : 'bg-rose'" :style="{ width: Math.min(100, total / FREE_SHIPPING_THRESHOLD * 100) + '%' }"></div>
          </div>
        </div>
        <div class="flex justify-between text-sm text-ink-2 lg:text-[15px]"><span>商品小計</span><span class="font-num text-ink">NT$ {{ total.toLocaleString() }}</span></div>
        <div class="flex justify-between text-sm text-ink-2 lg:text-[15px]"><span>運費</span><span class="text-ink" :class="{ 'font-num': shipping > 0 }">{{ shipping > 0 ? 'NT$ ' + shipping : '免運' }}</span></div>
        <div class="h-px bg-line"></div>
        <div class="flex items-center justify-between"><span class="text-[15px] font-medium lg:text-base">總計</span><span class="font-num text-[22px] lg:text-[26px]">NT$ {{ (total + shipping).toLocaleString() }}</span></div>
        <button @click="goCheckout" class="btn-primary mt-1 hidden h-[54px] lg:flex">前往結帳</button>
        <p class="hidden items-center justify-center gap-2 text-[13px] text-ink-3 lg:flex"><%- include('../partials/icon', { name: 'shield-check', cls: 'w-4 h-4' }) %>結帳後將前往綠界 ECPay 安全付款</p>
      </aside>

      <a href="/#products" class="inline-flex items-center gap-2 text-sm text-rose lg:hidden"><%- include('../partials/icon', { name: 'arrow-left', cls: 'w-4 h-4' }) %>繼續選購</a>
    </div>

    <div class="h-[88px] lg:hidden"></div>
    <div class="fixed inset-x-0 bottom-0 z-40 flex items-center gap-3.5 border-t border-line bg-white px-5 pb-6 pt-3 shadow-[0_-4px_16px_rgba(34,56,46,0.08)] lg:hidden">
      <div>
        <p class="text-xs text-ink-3">總計</p>
        <p class="font-num text-xl">NT$ {{ (total + shipping).toLocaleString() }}</p>
      </div>
      <button @click="goCheckout" class="btn-primary flex-1">前往結帳</button>
    </div>
  </template>

  <div v-if="confirmVisible" class="fixed inset-0 z-[60] flex items-center justify-center">
    <div class="absolute inset-0 bg-stem/40" @click="confirmVisible = false"></div>
    <div role="dialog" aria-modal="true" aria-labelledby="confirm-title" class="relative mx-5 w-full max-w-sm rounded-md bg-white p-6 text-center">
      <h3 id="confirm-title" class="font-serif text-lg font-semibold text-stem">移除這項商品？</h3>
      <p class="mt-2 text-sm text-ink-2">移除後可再從商品頁重新加入。</p>
      <div class="mt-6 flex justify-center gap-3">
        <button @click="confirmVisible = false" class="rounded-md border border-line px-5 py-2.5 text-sm text-ink-2 hover:border-stem">保留</button>
        <button @click="handleDelete" class="rounded-md bg-error px-5 py-2.5 text-sm text-white hover:opacity-90">移除</button>
      </div>
    </div>
  </div>
</div>
